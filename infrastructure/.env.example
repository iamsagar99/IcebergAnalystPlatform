# Copy to infrastructure/.env and adjust. Never commit infrastructure/.env.
# All values below are LOCAL-ONLY demo credentials.

COMPOSE_PROJECT_NAME=iap

# ---- object storage (MinIO-compatible: pgsty/silo, see docs/implementation-decisions.md) ----
S3_ROOT_USER=minioadmin
S3_ROOT_PASSWORD=minioadmin-change-me
S3_BUCKET=lakehouse
S3_REGION=local-01

# ---- engine service-account credentials for object storage ----
# In production each engine runs under its own identity (Kerberos/HDFS). Locally they share one key.
ENGINE_S3_ACCESS_KEY=minioadmin
ENGINE_S3_SECRET_KEY=minioadmin-change-me

# ---- postgres (lakekeeper metadata + kyuubi auth table) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-change-me
LAKEKEEPER_DB=lakekeeper
KYUUBI_AUTH_DB=kyuubi_auth

# ---- lakekeeper ----
LAKEKEEPER_PG_ENCRYPTION_KEY=local-only-encryption-key-change-me
LAKEKEEPER_WAREHOUSE=lakehouse

# ---- trino ----
TRINO_SHARED_SECRET=local-only-shared-secret-change-me
TRINO_HEAP=2G

# ---- demo analyst identities (same users on both engines) ----
ADMIN_PASSWORD=admin-pass
ANALYST_PASSWORD=analyst-pass
RESTRICTED_PASSWORD=restricted-pass
ETL_PASSWORD=etl-pass
BENCH_PASSWORD=bench-pass

# ---- kyuubi ----
KYUUBI_ENGINE_DRIVER_MEMORY=768m
KYUUBI_ENGINE_CORES=2

# ---- jupyter ----
JUPYTER_TOKEN=lakehouse

# ---- grafana ----
GRAFANA_ADMIN_PASSWORD=grafana-change-me

# ---- kyuubi JDBC-auth database reader (SELECT-only role on kyuubi_auth) ----
KYUUBI_AUTH_DB_USER=kyuubi_auth
KYUUBI_AUTH_DB_PASSWORD=kyuubi-auth-change-me
