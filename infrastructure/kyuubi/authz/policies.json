    {
      "name": "row filter: customer_pii",
      "description": "restricted analysts: only opted-in customers. analysts: no rows at all (closes the COUNT(*) row-count leak: the AuthZ plugin does not authorize column-less scans; verified on Kyuubi 1.12.0). Filter uses a non-foldable contradiction so the relation is kept and column checks still apply.",
      "policyType": 2,
      "resources": {
        "database": {
          "values": [
            "silver"
          ]
        },
        "table": {
          "values": [
            "customer_pii"
          ]
        }
      },
      "rowFilterPolicyItems": [
        {
          "groups": [
            "restricted_analysts"
          ],
          "accesses": [
            {
              "type": "select",
              "isAllowed": true
            }
          ],
          "rowFilterInfo": {
            "filterExpr": "marketing_opt_in = true"
          }
        },
        {
          "groups": [
            "analysts"
          ],
          "accesses": [
            {
              "type": "select",
              "isAllowed": true
            }
          ],
          "rowFilterInfo": {
            "filterExpr": "customer_id < 0 AND customer_id > 0"
          }
        }
      ]
    },
    {
